{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /*  Pragmatic relaxed mode for the .js → .ts migration.
        We still benefit from:
          - typed cross-module APIs via the central `types.ts`
          - structural typing on objects we explicitly annotate
          - module resolution / import errors
          - typo detection on known types
        Once the codebase has settled we can tighten these step by step
        (start with `strictNullChecks` → then `strict`). */
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true,

    "allowJs": true,
    "checkJs": false,

    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.js", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
